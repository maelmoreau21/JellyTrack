# Copy this file to .env. Replace CHANGE_ME values before exposing the service.

# Runtime
TZ=Europe/Paris
PORT=3000
APP_PORT=3000
JELLYTRACK_PORT=
LOG_LEVEL=info
GOMEMLIMIT=32MiB
BACKUP_DIR=/data/backups

# Database: standalone mode uses SQLite in the persistent /data volume.
# To use an externally managed PostgreSQL database, set DATABASE_DRIVER=postgres
# and DATABASE_URL=postgresql://user:password@host:5432/database.
# PostgreSQL connectivity is wired in phase 2; no database service is deployed here.
DATABASE_DRIVER=sqlite
DATABASE_PATH=/data/jellytrack.db
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
JELLYTRACK_DB_USER=
JELLYTRACK_DB_PASSWORD=
JELLYTRACK_DB_NAME=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_IP=
POSTGRES_PORT=5432
POSTGRES_DB=
PUID=65532
PGID=65532
VALKEY_URL=
REDIS_URL=
VALKEY_IMAGE=
REDIS_IMAGE=

# Authentication and session (used in later phases)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_SECRET
AUTH_SECRET=
JELLYTRACK_SECRET=
JELLYTRACK_URL=
JELLYGATE_URL=
AUTH_TRUSTED_ORIGIN=
AUTH_TRUSTED_ORIGINS=
AUTH_TRUSTED_HOSTS=
ALLOW_MISSING_ORIGIN_FOR_MUTATIONS=false
JELLYTRACK_LOCAL_ADMIN_USER=admin
JELLYTRACK_LOCAL_ADMIN_PASSWORD=
JELLYGATE_LOCAL_ADMIN_USER=
JELLYGATE_LOCAL_ADMIN_PASSWORD=

# Jellyfin and its plugin (used in later phases)
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=CHANGE_ME_JELLYFIN_API_KEY
JELLYTRACK_JELLYFIN_API_KEY=
JELLYFIN_SERVER_ID=master
JELLYFIN_SERVER_NAME=Master Jellyfin
JELLYFIN_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
JELLYTRACK_WEBHOOK_SECRET=
PLUGIN_KEY_PEPPER=CHANGE_ME_RANDOM_PLUGIN_KEY_PEPPER
PLUGIN_KEY_PREVIOUS_PEPPERS=
PLUGIN_EVENT_MAX_BYTES=1048576
PLUGIN_EVENT_RATE_LIMIT_MAX=
PLUGIN_EVENT_RATE_LIMIT_WINDOW_SECONDS=
PLUGIN_HEARTBEAT_TIMEOUT_SEC=
PLUGIN_HEALTH_GAP_CRITICAL_SEC=
PLUGIN_HEALTH_GAP_WARNING_SEC=
PLUGIN_HEALTH_JITTER_CRITICAL_SEC=
PLUGIN_HEALTH_JITTER_WARNING_SEC=
MERGE_WINDOW_MS=
ALLOWED_JELLYFIN_HOSTS=jellyfin
ALLOWED_HOSTS=
TRUSTED_PROXY_HOPS=
TRUSTED_PROXY_CIDRS=

# OIDC / OpenID Connect (used in later phases)
OIDC_ENABLED=false
OIDC_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_USER_GROUP=
OIDC_ADMIN_GROUP=
OIDC_TOKEN_ALG=RS256
OIDC_AUTO_REDIRECT=true
OIDC_AUTO_LOGIN=
OIDC_ALLOW_FUZZY_USER_MATCHING=
AUTHENTIK_URL=
JELLYTRACK_AUTHENTIK_URL=

# Compatibility and maintenance options (used in later phases)
RETENTION_DAYS=90
MERGE_WINDOW_MINUTES=60
DRY_RUN=false
BACKUP_IMPORT_MAX_BYTES=
ALLOW_FALLBACK_ADMIN=
DEBUG_COLLECTIONS=
IMAGE_CACHE_DIR=
LOG_DIR=/data/logs
LOG_MAX_FILE_SIZE_BYTES=5242880
NODE_ENV=production
NODE_OPTIONS=
ANALYZE=
SKIP_INSTRUMENTATION=
NEXT_PHASE=
NEXT_RUNTIME=
XDG_CACHE_HOME=
HOSTNAME=
APP_VERSION=v3
PRISMA_USE_STUB=0
JELLYTRACK_MODE=single
JELLYTRACK_PRISMA_ACCEPT_DATA_LOSS=false
