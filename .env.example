# Copy this file to .env and replace every CHANGE_ME value before deployment.

# Database Configuration
# 1) Integrated PostgreSQL (default: docker-compose.yml):
#    Requires POSTGRES_PASSWORD to be defined below.
# 2) Standalone SQLite (docker-compose.sqlite.yml):
#    No PostgreSQL container needed, POSTGRES_PASSWORD is not required.
#    Uses DATABASE_PATH (/data/jellytrack.db).
# 3) External PostgreSQL (docker-compose.postgres-external.yml):
#    Configure DATABASE_URL or DB_* connection parameters.

DATABASE_DRIVER=postgres
POSTGRES_USER=JellyTrack
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_IP=postgres
POSTGRES_PORT=5432
POSTGRES_DB=JellyTrack
# Optional full PostgreSQL connection string (for external PostgreSQL):
# DATABASE_URL=postgresql://user:password@remote-host:5432/jellytrack?sslmode=disable
DATABASE_URL=
# SQLite file path (used in standalone SQLite mode):
DATABASE_PATH=/data/jellytrack.db

# Core app
TZ=Europe/Paris
JELLYTRACK_MODE=single
PORT=3000
APP_PORT=3000
BACKUP_DIR=/data/backups
# Optional independent base64 key encoding exactly 32 random bytes. Keep outside backups.
# Required for complete exports and pre-repair SQLite snapshots; never use the fixture key.
BACKUP_ENCRYPTION_KEY=
LOG_LEVEL=info

# Primary Jellyfin server
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=CHANGE_ME_JELLYFIN_API_KEY
JELLYFIN_SERVER_ID=master
JELLYFIN_SERVER_NAME=Master Jellyfin

# Security & Sessions
# Must be at least 32 characters long
JELLYTRACK_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_SECRET
JELLYTRACK_URL=http://localhost:3000
JELLYFIN_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
PLUGIN_KEY_PEPPER=CHANGE_ME_RANDOM_PLUGIN_KEY_PEPPER
PLUGIN_KEY_PREVIOUS_PEPPERS=
ALLOWED_JELLYFIN_HOSTS=jellyfin
PLUGIN_EVENT_MAX_BYTES=1048576

# Single Sign-On (SSO / OpenID Connect)
# Set OIDC_ENABLED=true to authenticate users via your OIDC identity provider (e.g. Authentik, Keycloak, Authelia)
# Classic Jellyfin login (independent of OIDC_ENABLED).
JELLYFIN_AUTH_ENABLED=true
# LDAP accounts must use SSO; native Jellyfin accounts use their password.
LDAP_SSO_ONLY=true
OIDC_ENABLED=false
OIDC_URL=https://authentik.example.com/application/o/jellytrack/
OIDC_CLIENT_ID=jellytrack
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
# OIDC Groups (matches user groups from LDAP/SSO provider)
OIDC_USER_GROUP=
OIDC_ADMIN_GROUP=
# Auto-redirect unauthenticated users directly to the SSO provider (default: true)
OIDC_AUTO_REDIRECT=true

# Emergency Local Administrator Access
# If JELLYTRACK_LOCAL_ADMIN_PASSWORD is set (min 12 chars), local authentication is available.
# If left empty, local authentication is disabled.
# Local administrator is super_admin. Jellyfin/OIDC administrators are server_admin.
# Optional explicit global grants by verified internal server ID and Jellyfin user ID:
# JELLYTRACK_SUPER_ADMIN_IDENTITIES='[{"serverId":"server-id","userId":"jellyfin-user-id"}]'
JELLYTRACK_SUPER_ADMIN_IDENTITIES=[]
JELLYTRACK_LOCAL_ADMIN_USER=admin
JELLYTRACK_LOCAL_ADMIN_PASSWORD=

# Optional profiling & metrics
ENABLE_PPROF=false
