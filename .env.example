# Copy this file to .env and replace every CHANGE_ME value before deployment.

# Database
POSTGRES_USER=JellyTrack
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_IP=postgres
POSTGRES_PORT=5432
POSTGRES_DB=JellyTrack
# Docker: leave empty to let docker-entrypoint.sh build it from POSTGRES_* / DB_*.
# Local source dev: set it to postgresql://JellyTrack:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/JellyTrack
DATABASE_URL=

# Valkey / Redis
VALKEY_URL=redis://valkey:6379
# Image to use for the cache service container. Defaults to valkey/valkey:8-alpine.
# To use Redis instead, uncomment the lines below:
# VALKEY_IMAGE=mirror.gcr.io/library/redis:7-alpine
# VALKEY_URL=redis://valkey:6379

# Core app
TZ=Europe/Paris
JELLYTRACK_MODE=single
PORT=3000
# JELLYTRACK_PORT=3000 (alias for PORT)
APP_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_SECRET
# JELLYTRACK_SECRET=CHANGE_ME (alias for NEXTAUTH_SECRET)
BACKUP_DIR=/data/backups

# Primary Jellyfin server
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=CHANGE_ME_JELLYFIN_API_KEY
# JELLYTRACK_JELLYFIN_API_KEY=CHANGE_ME (alias for JELLYFIN_API_KEY)
JELLYFIN_SERVER_ID=master
JELLYFIN_SERVER_NAME=Master Jellyfin

# Security
JELLYFIN_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
# JELLYTRACK_WEBHOOK_SECRET=CHANGE_ME (alias for JELLYFIN_WEBHOOK_SECRET)
PLUGIN_KEY_PEPPER=CHANGE_ME_RANDOM_PLUGIN_KEY_PEPPER
PLUGIN_KEY_PREVIOUS_PEPPERS=
ALLOWED_JELLYFIN_HOSTS=jellyfin
PLUGIN_EVENT_MAX_BYTES=1048576

# Single Sign-On (SSO / OpenID Connect)
# Set OIDC_ENABLED=true to authenticate users via your OIDC identity provider (e.g. Authentik, Keycloak, Authelia)
OIDC_ENABLED=false
OIDC_URL=https://authentik.example.com/application/o/jellytrack/
OIDC_CLIENT_ID=jellytrack
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
# OIDC Groups (matches user groups from LDAP/SSO provider)
OIDC_USER_GROUP=jellyfin-users
OIDC_ADMIN_GROUP=jellyfin-admins
# OIDC Token Algorithm: RS256 (recommended for Authentik, Keycloak, Authelia) or HS256 / ES256
OIDC_TOKEN_ALG=RS256
# Auto-redirect unauthenticated users directly to the SSO provider (default: true)
OIDC_AUTO_REDIRECT=true

# Emergency Local Administrator Access
# If JELLYTRACK_LOCAL_ADMIN_PASSWORD is set, a discreet "Connexion locale" button will appear on the login page.
# If left empty, local authentication is completely disabled.
JELLYTRACK_LOCAL_ADMIN_USER=admin
JELLYTRACK_LOCAL_ADMIN_PASSWORD=
# Aliases: JELLYGATE_LOCAL_ADMIN_USER, JELLYGATE_LOCAL_ADMIN_PASSWORD

# Local testing only
PRISMA_USE_STUB=0

