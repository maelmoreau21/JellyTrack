{
  "name": "jellytrack-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "prepare": "node scripts/prepare-assets.mjs && svelte-kit sync",
    "dev": "node scripts/prepare-assets.mjs && vite dev --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:browser": "node scripts/browser-parity.mjs",
    "test:login": "node scripts/login-parity.mjs",
    "test:runtime": "node scripts/runtime-contracts.mjs",
    "test:dashboard": "node scripts/dashboard-parity.mjs",
    "test:backups": "node scripts/backups-parity.mjs",
    "test:accounts": "node scripts/accounts-parity.mjs",
    "test:users": "node scripts/users-parity.mjs",
    "test:integration": "node scripts/integration-parity.mjs",
    "build": "node scripts/prepare-assets.mjs && vite build && node scripts/externalize-bootstrap.mjs && node scripts/install-build.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
